{
  "manifest_version": 3,
  "name": "Dashboard - New Tab",
  "version": "1.0.0",
  "description": "Opens your Dashboard (running on localhost) as the Chrome new tab page.",
  "chrome_url_overrides": {
    "newtab": "redirect.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs"
  ],
  "icons": {
    "128": "icon-128.png"
  }
}